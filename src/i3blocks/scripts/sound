#!/bin/sh

VOLUME_MUTE=""
VOLUME_LOW=""
VOLUME_MID=""
VOLUME_HIGH=""

SINK="@DEFAULT_AUDIO_SINK@"

case $BLOCK_BUTTON in
  1) wpctl set-mute $SINK toggle ;;   # left click
  4) wpctl set-volume $SINK 10%+ ;;   # scroll up
  5) wpctl set-volume $SINK 10%- ;;   # scroll down
esac

# Pega volume e estado
INFO=$(wpctl get-volume $SINK)

# Extrai volume (float 0.00-1.00 → %)
SOUND_LEVEL=$(echo "$INFO" | awk '{printf "%d", $2 * 100}')

# Detecta mute
echo "$INFO" | grep -q MUTED && MUTED=1 || MUTED=0

if [ "$MUTED" = "1" ]; then
    ICON="$VOLUME_MUTE"
else
    if [ "$SOUND_LEVEL" -lt 34 ]; then
        ICON="$VOLUME_LOW"
    elif [ "$SOUND_LEVEL" -lt 67 ]; then
        ICON="$VOLUME_MID"
    else
        ICON="$VOLUME_HIGH"
    fi
fi

printf " %s %3s%% \n" "$ICON" "$SOUND_LEVEL"
