#!/bin/sh

CARD="card1"
HW="/sys/class/drm/$CARD/device"

# GPU Usage (%)
USAGE=$(cat $HW/gpu_busy_percent 2>/dev/null | awk '{printf "%d%%", $1}')

# Memória VRAM usada (%)
USED=$(cat $HW/mem_info_vram_used 2>/dev/null)
TOTAL=$(cat $HW/mem_info_vram_total 2>/dev/null)

if [ -n "$USED" ] && [ -n "$TOTAL" ] && [ "$TOTAL" -ne 0 ]; then
    MEM=$(awk -v u="$USED" -v t="$TOTAL" 'BEGIN { printf "%d%%", (u/t)*100 }')
else
    MEM="N/A"
fi

# Temperatura (°C)
TEMP_RAW=$(cat $HW/hwmon/hwmon*/temp1_input 2>/dev/null | head -n1)

if [ -n "$TEMP_RAW" ]; then
    TEMP=$(awk -v t="$TEMP_RAW" 'BEGIN { printf "%d°", t/1000 }')
else
    TEMP="N/A"
fi

echo " $USAGE - $MEM - $TEMP"
