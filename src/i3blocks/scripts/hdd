#!/bin/sh

TARGET="/"

RAW=$(btrfs filesystem usage -b $TARGET 2>/dev/null)

USED=$(echo "$RAW" | awk '/Used:/ {print $2; exit}')
TOTAL=$(echo "$RAW" | awk '/Device size:/ {print $3; exit}')

# Converte bytes → GiB
USED_G=$(awk -v u="$USED" 'BEGIN { printf "%.1fG", u/1024/1024/1024 }')
TOTAL_G=$(awk -v t="$TOTAL" 'BEGIN { printf "%.1fG", t/1024/1024/1024 }')

echo " $USED_G/$TOTAL_G"
